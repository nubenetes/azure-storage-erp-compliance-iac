            "name": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "primaryBlobEndpoint": {
              "type": "string",
              "value": "[reference('storageAccount').primaryEndpoints.blob]"
            }
          }
        }
      }
    },
    "containersModule": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('deploy-containers-{0}', variables('resolvedStorageAccountName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[reference('storageModule').outputs.name.value]"
          },
          "containerNames": {
            "value": "[parameters('containerNames')]"
          },
          "retentionDays": {
            "value": "[parameters('retentionDays')]"
          },
          "allowProtectedAppendWrites": {
            "value": true
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "14959218658916954003"
            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Name of the parent storage account"
              }
            },
            "containerNames": {
              "type": "array",
              "defaultValue": [
                "facturas",
                "pedidos"
              ],
              "metadata": {
                "description": "List of container names to provision"
              }
            },
            "retentionDays": {
              "type": "int",
              "defaultValue": 2190,
              "metadata": {
                "description": "WORM retention period in days (2,190 days = 6 years Código de Comercio Art. 30)"
              }
            },
            "allowProtectedAppendWrites": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Allow appending new blocks without modifying historical blocks"
              }
            }
          },
          "resources": [
            {
              "copy": {
                "name": "containers",
                "count": "[length(parameters('containerNames'))]"
              },
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}/{2}', parameters('storageAccountName'), 'default', parameters('containerNames')[copyIndex()])]",
              "properties": {
                "publicAccess": "None"
              }
            },
            {
              "copy": {
                "name": "immutabilityPolicies",
                "count": "[length(parameters('containerNames'))]"
              },
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}/{2}/{3}', parameters('storageAccountName'), 'default', parameters('containerNames')[copyIndex()], 'default')]",
              "properties": {
                "immutabilityPeriodSinceCreationInDays": "[parameters('retentionDays')]",
                "allowProtectedAppendWrites": "[parameters('allowProtectedAppendWrites')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('containerNames')[copyIndex()])]"
              ]
            }
          ],
          "outputs": {
            "containerIds": {
              "type": "array",
              "copy": {
                "count": "[length(parameters('containerNames'))]",
                "input": "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('containerNames')[copyIndex()])]"
              }
            }
          }
        }
      },
      "dependsOn": [
        "storageModule"
      ]
    },
    "lifecycleModule": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('deploy-lifecycle-{0}', variables('resolvedStorageAccountName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[reference('storageModule').outputs.name.value]"
          },
          "prefixMatches": {
            "copy": [
              {
                "name": "value",
                "count": "[length(parameters('containerNames'))]",
                "input": "[format('{0}/', parameters('containerNames')[copyIndex('value')])]"
              }
            ]
          },
          "tierToCoolDays": {
            "value": 90
          },
          "tierToColdDays": {
            "value": 365
          },
          "tierToArchiveDays": {
            "value": 1095
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "17705877184855376506"
            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Storage account name"
              }
            },
            "prefixMatches": {
              "type": "array",
              "defaultValue": [
                "facturas/",
                "pedidos/"
              ],
              "metadata": {
                "description": "Prefix matches for lifecycle rules"
              }
            },
            "tierToCoolDays": {
              "type": "int",
              "defaultValue": 90,
              "metadata": {
                "description": "Days before tiering to Cool"
              }
            },
            "tierToColdDays": {
              "type": "int",
              "defaultValue": 365,
              "metadata": {
                "description": "Days before tiering to Cold"
              }
            },
            "tierToArchiveDays": {
              "type": "int",
              "defaultValue": 1095,
              "metadata": {
                "description": "Days before tiering to Archive"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts/managementPolicies",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
              "properties": {
                "policy": {
                  "rules": [
                    {
                      "enabled": true,
                      "name": "tier-erp-invoices-and-orders",
                      "type": "Lifecycle",
                      "definition": {
                        "filters": {
                          "blobTypes": [
                            "blockBlob"
                          ],
                          "prefixMatch": "[parameters('prefixMatches')]"
                        },
                        "actions": {
                          "baseBlob": {
                            "tierToCool": {
                              "daysAfterModificationGreaterThan": "[parameters('tierToCoolDays')]"
                            },
                            "tierToCold": {
                              "daysAfterModificationGreaterThan": "[parameters('tierToColdDays')]"
                            },
                            "tierToArchive": {
                              "daysAfterModificationGreaterThan": "[parameters('tierToArchiveDays')]"
                            }
                          },
                          "snapshot": {
                            "tierToCool": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToCoolDays')]"
                            },
                            "tierToCold": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToColdDays')]"
                            },
                            "tierToArchive": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToArchiveDays')]"
                            }
                          },
                          "version": {
                            "tierToCool": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToCoolDays')]"
                            },
                            "tierToCold": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToColdDays')]"
                            },
                            "tierToArchive": {
                              "daysAfterCreationGreaterThan": "[parameters('tierToArchiveDays')]"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts/managementPolicies', parameters('storageAccountName'), 'default')]"
            }
          }
        }
      },
      "dependsOn": [
        "containersModule",
        "storageModule"
      ]
    },
    "lockModule": {
      "condition": "[parameters('enableResourceLock')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('deploy-lock-{0}', variables('resolvedStorageAccountName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[reference('storageModule').outputs.name.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "10920576924082298796"
            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Storage account name"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/locks",
              "apiVersion": "2020-05-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[format('lock-{0}-prevent-deletion', parameters('storageAccountName'))]",
              "properties": {
                "level": "CanNotDelete",
                "notes": "Protects ERP compliance storage account against accidental or malicious deletion."
              }
            }
          ],
          "outputs": {
            "lockId": {
              "type": "string",
              "value": "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), 'Microsoft.Authorization/locks', format('lock-{0}-prevent-deletion', parameters('storageAccountName')))]"
            }
          }
        }
      },
      "dependsOn": [
        "lifecycleModule",
        "storageModule"
      ]
    }
  },
  "outputs": {
    "storageAccountId": {
      "type": "string",
      "value": "[reference('storageModule').outputs.id.value]"
    },
    "storageAccountName": {
      "type": "string",
