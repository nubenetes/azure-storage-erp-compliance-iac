  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "8817911989456014180"
    }
  },
  "definitions": {
    "environmentType": {
      "type": "string",
      "allowedValues": [
        "dev",
        "prod",
        "staging"
      ],
      "metadata": {
        "description": "Deployment environment"
      }
    },
    "skuType": {
      "type": "string",
      "allowedValues": [
        "Standard_GRS",
        "Standard_GZRS",
        "Standard_LRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "Storage replication SKU (ZRS recommended for Madrid 3-zone HA)"
      }
    }
  },
  "parameters": {
    "environment": {
      "$ref": "#/definitions/environmentType",
      "defaultValue": "prod",
      "metadata": {
        "description": "Deployment environment: dev, staging, prod"
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "erp",
      "metadata": {
        "description": "Project identifier"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "spaincentral",
      "metadata": {
        "description": "Azure Region (defaults to Spain Central - Madrid)"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Storage Account name. If empty, a unique name is generated."
      }
    },
    "skuName": {
      "$ref": "#/definitions/skuType",
      "defaultValue": "Standard_ZRS",
      "metadata": {
        "description": "Storage replication SKU (ZRS recommended for Madrid 3-zone HA)"
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 2190,
      "metadata": {
        "description": "WORM retention period in days (2,190 days = 6 years Código de Comercio Art. 30)"
      }
    },
    "softDeleteDays": {
      "type": "int",
