      "metadata": {
        "description": "Soft delete retention in days"
      }
    },
    "enableResourceLock": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable CanNotDelete management lock"
      }
    },
    "containerNames": {
      "type": "array",
      "defaultValue": [
        "facturas",
        "pedidos"
      ],
      "metadata": {
        "description": "List of container names to create"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Workload": "ERP-Document-Archive",
        "LegalCompliance": "Codigo-de-Comercio-Art30-VeriFactu",
        "Country": "Spain",
        "ManagedBy": "Bicep"
      },
      "metadata": {
        "description": "Tags for deployed resources"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[substring(uniqueString(resourceGroup().id, parameters('projectName'), parameters('environment')), 0, 6)]",
    "resolvedStorageAccountName": "[if(empty(parameters('storageAccountName')), format('st{0}{1}{2}', parameters('projectName'), parameters('environment'), variables('uniqueSuffix')), toLower(parameters('storageAccountName')))]"
  },
  "resources": {
    "storageModule": {
